// Cloudflare Workers deploy config — TEMPLATE.
// The /deploy-cloudflare skill copies this to wrangler.jsonc (gitignored, your
// working copy) and fills in the real values (D1 database_id, production URL).
// `pnpm cf:build` (NITRO_PRESET=cloudflare_module) merges wrangler.jsonc into
// the generated .output/server/wrangler.json; deploy with `pnpm cf:deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genjutsu-ai",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    // Server-side runtime fallbacks for the build-time VITE_* values — keep in
    // sync with .env.production (better-auth trustedOrigins, payment callbacks).
    "VITE_APP_URL": "https://genjutsuai.net",
    "VITE_APP_NAME": "Genjutsu AI",
    "VITE_APP_SUPPORT_EMAIL": "support@genjutsuai.net",
    // Android Chrome image materialize grayscale (client bake + runtime fallback).
    "VITE_ANDROID_CHROME_MATERIALIZE_UPLOADS": "true",
    // Homepage Genjutsu → Higgsfield Light (HF_API_KEY is a secret).
    // CI copies this file to wrangler.jsonc on every deploy; omitting these
    // wipes production vars.
    "GENJUTSU_MOTION_PROVIDER": "higgsfield",
    "GENJUTSU_OBJECT_SWAP_PROVIDER": "higgsfield",
    "HIGGSFIELD_GENJUTSU_MOTION_MODEL": "higgsfield/genjutsu-light/motion-transfer/v1.0",
    "HIGGSFIELD_GENJUTSU_OBJECT_SWAP_MODEL": "higgsfield/genjutsu-light/object-swap/v1.0",
    // Allowlisted product pages stay on WaveSpeed Seedance 2.5.
    "GENJUTSU_PRODUCT_PROVIDER": "seedance-wavespeed",
    // Keep Ark vars for rollback.
    "ARK_API_BASE_URL": "https://ark.cn-beijing.volces.com/api/v3",
    "SEEDANCE_VOLCENGINE_MODEL": "doubao-seedance-2-5-260628",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "genjutsu-ai-db",
      "database_id": "REPLACE_WITH_OUTPUT_OF_WRANGLER_D1_CREATE",
      "migrations_dir": "drizzle",
    },
  ],
  // ── Postgres via Hyperdrive (instead of D1) ────────────────────────────────
  // 1. npx wrangler hyperdrive create <name> --connection-string="postgres://..." (your direct PG url)
  // 2. Set vars.DATABASE_PROVIDER to "postgresql" and remove the d1_databases block
  // 3. Uncomment and fill the binding (the build keeps the postgres driver in
  //    the bundle when DATABASE_PROVIDER=postgresql — see vite.config.ts):
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "REPLACE_WITH_OUTPUT_OF_WRANGLER_HYPERDRIVE_CREATE" }
  // ]
  //
  // Other optional bindings — uncomment when needed:
  // "kv_namespaces":  [{ "binding": "CACHE",  "id": "..." }],
  // Genjutsu proxy uploads (PUT /api/genjutsu/upload/...) stream into this binding.
  // CI copies this file to wrangler.jsonc — keep R2_BUCKET enabled for production.
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "genjutsu-ai",
    },
  ],
  // Optional unattended image-to-video recovery (NOT enabled by default).
  // 1. Set secret CRON_SECRET via `wrangler secret put CRON_SECRET`
  // 2. Uncomment triggers and point at your production host:
  // "triggers": {
  //   "crons": ["*/5 * * * *"]
  // }
  // Pair with a Worker scheduled handler or external ping to
  // POST /api/cron/image-to-video/reconcile with Authorization: Bearer <CRON_SECRET>.
  // Code supports reconcile; without this deploy config, recovery still needs
  // client polling or POST /api/admin/image-to-video/reconcile.
}
